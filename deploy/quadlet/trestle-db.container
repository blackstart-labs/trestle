[Unit]
Description=Trestle PostgreSQL

[Container]
Image=docker.io/library/postgres:18-trixie@sha256:e3d24f6906d0760bf4da0dae872415391ededefad23fd471c47dc53b0ddf3c42
ContainerName=trestle-db
Network=trestle.network
EnvironmentFile=./trestle.env
Environment=POSTGRES_DB=trestle POSTGRES_USER=trestle
Volume=trestle-postgres.volume:/var/lib/postgresql
HealthCmd=pg_isready -h 127.0.0.1 -U trestle -d trestle
HealthInterval=3s
HealthTimeout=2s
HealthRetries=20
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=180
