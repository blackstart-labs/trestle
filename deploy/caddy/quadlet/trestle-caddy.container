[Unit]
Description=Trestle HTTPS reverse proxy
Requires=trestle-app.service
After=trestle-app.service

[Container]
Image=docker.io/library/caddy:2.11-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f
ContainerName=trestle-caddy
Network=trestle-ingress.network
Environment=TRESTLE_DOMAIN=@TRESTLE_DOMAIN@
PublishPort=80:80
PublishPort=443:443
Volume=./Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=trestle-caddy-data.volume:/data
Tmpfs=/config
ReadOnly=true
NoNewPrivileges=true

[Service]
Restart=on-failure
TimeoutStartSec=180

[Install]
WantedBy=default.target
