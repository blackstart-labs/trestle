# Copy to .env for compose.prod.yaml. Replace the password before starting.
# DATABASE_URL must name the compose service (db), not 127.0.0.1.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgres://trestle:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@db:5432/trestle?sslmode=disable
# Publish Trestle on loopback and put Caddy, nginx or Traefik in front for TLS.
TRESTLE_HTTP_BIND=127.0.0.1:3000
TRESTLE_MAX_DB_CONNECTIONS=10
TRESTLE_DB_TIMEOUT_MS=2000
SESSION_TTL_HOURS=336
